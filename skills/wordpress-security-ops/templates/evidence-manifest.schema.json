{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/MADEVAL/wordpress-security-ops/templates/evidence-manifest.schema.json",
  "title": "WordPress Security Ops Evidence Manifest",
  "type": "object",
  "required": ["manifest_version", "created_at", "collector", "items"],
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "collector": { "type": "string" },
    "root": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "mtime", "collected_at", "source", "redaction"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "mtime": { "type": "string" },
          "collected_at": { "type": "string", "format": "date-time" },
          "collector": { "type": "string" },
          "source": { "type": "string", "enum": ["filesystem", "database", "log", "ability", "export", "manual"] },
          "redaction": { "type": "string", "enum": ["none", "masked", "redacted"] },
          "chain_of_custody": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["who", "host", "at"],
              "properties": {
                "who": { "type": "string" },
                "host": { "type": "string" },
                "at": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
